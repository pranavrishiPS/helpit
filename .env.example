# OpenAI (optional — powers the assistant)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional server-only API key for non-browser callers (scripts, curl): send it as
# the x-helpit-api-key header or "Authorization: Bearer". Never expose it to the
# browser (no NEXT_PUBLIC_ variant) - the app authenticates via the site sign-in
# session below, which also satisfies the API gate.
HELPIT_API_KEY=

# Site-wide Google sign-in gate — locks every page and API to specific accounts.
# Off by default locally; set both to enable it. REQUIRED in production: Helpit
# returns 503 on Vercel / NODE_ENV=production unless both are set (HELPIT_API_KEY
# alone is NOT enough: the browser signs in via this, it never sends the API key).
# SITE_AUTH_SECRET is the only session-signing secret used (no fallback to
# GOOGLE_CLIENT_SECRET). Reuses GOOGLE_CLIENT_ID/SECRET below, but
# needs its own redirect URI added to the OAuth client:
# http://localhost:3000/api/auth/google/callback (and the prod equivalent)
SITE_AUTH_ALLOWED_EMAILS=
SITE_AUTH_SECRET=

# App URL (used for OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Blob — connected automatically on Vercel; needed for local Blob testing
# BLOB_READ_WRITE_TOKEN=

# Gmail — create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# Pre-select account on Google sign-in (optional)
GMAIL_LOGIN_HINT=

# Scrum attendance <-> Google Sheet sync — reuses GOOGLE_CLIENT_ID/SECRET above.
# Also: enable the "Google Sheets API" in the same Cloud project, and add
# http://localhost:3000/api/scrum-attendance/sheet/callback to the OAuth
# client's Authorized redirect URIs.
SCRUM_SHEET_REDIRECT_URI=http://localhost:3000/api/scrum-attendance/sheet/callback

# Slack — create at https://api.slack.com/apps
# Approved user scopes: groups:history, im:history, mpim:history, users:read
# (search:read and channels:history removed per workspace policy — auto-sync disabled)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3000/api/slack/callback
# Optional: skip OAuth and use a user token directly
# SLACK_USER_TOKEN=
